{
  "name": "@transomjs/transom-smtp",
  "version": "6.0.0",
  "description": "Add SMTP functions and email templating to server-side Transom code",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc -p tsconfig.json",
    "pretest": "npm run build",
    "deploy": "np",
    "test": "cross-env NODE_ENV=test c8 mocha",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transomjs/transom-smtp.git"
  },
  "keywords": [
    "smtp",
    "email"
  ],
  "author": "Mark Voorberg <mark@binaryops.ca>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/transomjs/transom-smtp/issues"
  },
  "homepage": "https://github.com/transomjs/transom-smtp#readme",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "c8": "^10.1.3",
    "chai": "^5.0.3",
    "cross-env": "^7.0.3",
    "mocha": "^10.2.0",
    "np": "^12.1.1",
    "pocket-registry": "^3.0.0",
    "shelljs": "^0.8.5",
    "sinon": "^17.0.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/nodemailer": "^6.4.24",
    "nodemailer": "^6.10.1"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "lib",
    "CHANGELOG.md"
  ]
}
